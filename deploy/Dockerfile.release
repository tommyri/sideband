# The release workflow supplies smoke-tested static musl binaries named
# ss-server-amd64 and ss-server-arm64. Only files are copied, so one buildx call
# builds both platforms without emulation. Keep the runtime equivalent to the
# source-build deploy/Dockerfile, including the pinned base digest.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETARCH
COPY --chown=65532:65532 --chmod=0755 ss-server-${TARGETARCH} /ss-server
COPY --chown=65532:65532 data /data
WORKDIR /data
VOLUME ["/data"]
EXPOSE 80/tcp 443/udp 443/tcp 9101/tcp
ENTRYPOINT ["/ss-server"]
CMD ["run", "--data-dir", "/data"]
